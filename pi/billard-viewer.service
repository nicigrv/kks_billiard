[Unit]
Description=Billard Kamera-Anzeige auf HDMI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# Zugriff auf HDMI (KMS/DRM) und Eingabegeraete ohne Desktop
SupplementaryGroups=video render input
WorkingDirectory=/home/pi/billard/pi
Environment=CAM_URL=http://192.168.178.50:81/stream
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 viewer.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
